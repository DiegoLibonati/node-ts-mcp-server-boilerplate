{
  "//": "Claude Desktop / Claude Code — stdio transport. Merge into claude_desktop_config.json.",
  "mcpServers": {
    "mcp-boilerplate": {
      "command": "node",
      "args": ["/absolute/path/to/node-ts-mcp-server-boilerplate/dist/main.js"],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "LOG_LEVEL": "info",
        "SEED_DEFAULT_DATA": "true"
      }
    }
  }
}
