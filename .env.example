# ---------------------------------------------------------------------------
# Environment files
# ---------------------------------------------------------------------------
# Copy this file to `.env` to run the server without Docker (npm run dev /
# npm start). Files are loaded in cascade and a key is only applied if it is
# not already set, so the precedence from highest to lowest is:
#   process.env > .env.<mode>.local > .env.local > .env.<mode> > .env
# Under NODE_ENV=test only .env.test.local and .env.test are read.
# Every key below is optional: env.config.ts provides a default for each one.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# MCP server identity (sent to the host on connect)
# ---------------------------------------------------------------------------
MCP_SERVER_NAME=mcp-boilerplate
MCP_SERVER_VERSION=1.0.0

# stdio | http
MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# HTTP transport (ignored when MCP_TRANSPORT=stdio)
# ---------------------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=5060
HTTP_PATH=/mcp

# Comma separated. Only used when HTTP_HOST binds to 0.0.0.0 / ::
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated. Empty disables the Origin allow-list.
ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=900000
# 0 disables rate limiting
RATE_LIMIT_MAX=0

# ---------------------------------------------------------------------------
# Auth (HTTP transport only)
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
SEED_DEFAULT_DATA=true
